# Copy to backend/.env (backend) and frontend/.env.local (frontend). NEVER commit real .env files.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./rag.db

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3
RETRIEVAL_THRESHOLD=0.35
MAX_UPLOAD_MB=25

SECRET_KEY=change-this-secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: use an OpenAI-compatible API instead of Ollama (set LLM_PROVIDER=openai)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

# Hallucination checks
GROUNDING_SUPPORT_THRESHOLD=0.5
GROUNDING_MIN_FAITHFULNESS=0.8
BLOCK_UNGROUNDED=false

# ---- Docker only (docker compose reads these from a file named .env in the project root) ----
# Where the backend container finds Ollama. Default = Ollama installed on your computer.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# Using `docker compose --profile ollama up` instead? Use:
# DOCKER_OLLAMA_URL=http://ollama:11434

# ---- Public server only (see docs/DEPLOYMENT.md) ----
# API_DOMAIN=api-yourname.duckdns.org     # HTTPS address of the backend, used by the Caddy proxy
# BACKEND_BIND=127.0.0.1                  # keep port 8000 private so only Caddy can reach it

# ---- Vector database ----
# faiss (default, exact search) or chroma (HNSW). Chroma needs: pip install -r backend/requirements-chroma.txt
# After switching, fill the new database with:  python -m app.scripts.reindex   (from backend/)
VECTOR_STORE=faiss
# Docker only: set to true to install Chroma into the backend image
# INSTALL_CHROMA=false
